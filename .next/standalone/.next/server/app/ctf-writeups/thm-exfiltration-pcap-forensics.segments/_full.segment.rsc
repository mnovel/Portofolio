24:[["$","p",null,{"children":[["$","strong",null,{"children":"Silent Exfiltration"}]," adalah tantangan forensik jaringan (",["$","em",null,{"children":"Network Forensics"}],") yang menyajikan rekaman tangkapan paket (",["$","code",null,{"children":"capture.pcapng"}],") dari sebuah server internal yang dicurigai mengalami kebocoran data (",["$","em",null,{"children":"data exfiltration"}],") tanpa memicu peringatan firewall perimeter."]}],"\n",["$","h2",null,{"children":"1. Triase Awal & Statistik Protokol"}],"\n",["$","p",null,{"children":["Langkah pertama dalam analisis forensik paket adalah memetakan distribusi protokol dan percakapan antar-host menggunakan ",["$","strong",null,{"children":"Wireshark"}]," (",["$","code",null,{"children":"Statistics -> Protocol Hierarchy"}],") atau ",["$","strong",null,{"children":"Tshark"}]," melalui terminal:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"tshark -r capture.pcapng -q -z io,phs\n"}]}],"\n",["$","p",null,{"children":["Hasil statistik menunjukkan bahwa lebih dari ",["$","strong",null,{"children":"82% total paket"}]," didominasi oleh protokol ",["$","strong",null,{"children":"DNS (UDP Port 53)"}]," menuju satu ",["$","em",null,{"children":"resolver"}]," eksternal (",["$","code",null,{"children":"198.51.100.77"}],"), sementara trafik HTTP/HTTPS sangat minim."]}],"\n",["$","h2",null,{"children":"2. Identifikasi Anomali DNS Query"}],"\n",["$","p",null,{"children":["Pemeriksaan kueri DNS mengungkap ratusan permintaan ",["$","code",null,{"children":"TXT"}]," dan ",["$","code",null,{"children":"A"}]," record dengan panjang subdomain yang tidak wajar mengarah ke domain ",["$","code",null,{"children":"sync-update.badactor.net"}],":"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"tshark -r capture.pcapng -Y \"dns.flags.response == 0\" -T fields -e frame.number -e dns.qry.name | head -n 15\n"}]}],"\n",["$","p",null,{"children":["Output terminal menampilkan pola subdomain berurutan dengan karakter acak (",["$","em",null,{"children":"high entropy"}],"):"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-text","children":"142   001-UEsDBBQAAAAI.sync-update.badactor.net\r\n145   002-A6B29C11AA00.sync-update.badactor.net\r\n149   003-c2VjcmV0X2RhdGE.sync-update.badactor.net\r\n...\n"}]}],"\n",["$","p",null,{"children":["Pola nomor urut (",["$","code",null,{"children":"001-"}],", ",["$","code",null,{"children":"002-"}],", ",["$","code",null,{"children":"003-"}],") yang diikuti string ",["$","strong",null,{"children":"Base64"}]," (diawali ",["$","code",null,{"children":"UEsDBBQ"}],", yang merupakan ",["$","em",null,{"children":"magic bytes"}]," header arsip ",["$","strong",null,{"children":"ZIP"}]," ",["$","code",null,{"children":"PK\\x03\\x04"}],") mengonfirmasi terjadinya ",["$","strong",null,{"children":"DNS Tunneling Data Exfiltration"}],"."]}],"\n",["$","h2",null,{"children":"3. Ekstraksi & Rekonstruksi Data dari PCAP"}],"\n",["$","p",null,{"children":["Untuk menyusun kembali potongan data dari seluruh paket kueri DNS secara akurat tanpa duplikasi paket ",["$","em",null,{"children":"retransmission"}],", digunakan kombinasi ",["$","code",null,{"children":"tshark"}],", ",["$","code",null,{"children":"sort"}],", dan ",["$","code",null,{"children":"base64"}]," di Linux:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"tshark -r capture.pcapng -Y \"dns.flags.response == 0 && dns.qry.name contains sync-update.badactor.net\" \\\r\n  -T fields -e dns.qry.name \\\r\n  | sed 's/.sync-update.badactor.net//g' \\\r\n  | sort -u \\\r\n  | cut -d'-' -f2 \\\r\n  | tr -d '\\n' \\\r\n  | base64 -d > recovered_archive.zip\n"}]}],"\n",["$","h3",null,{"children":"Verifikasi Integritas File Hasil Rekonstruksi"}],"\n",["$","p",null,{"children":["Pemeriksaan tipe file dan isi arsip menggunakan utilitas ",["$","code",null,{"children":"file"}]," dan ",["$","code",null,{"children":"unzip"}],":"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"file recovered_archive.zip\r\nunzip -l recovered_archive.zip\n"}]}],"\n",["$","p",null,{"children":["Output mengonfirmasi file hasil ekstraksi adalah arsip ZIP valid berisi dokumen ","$L25",". Setelah diekstrak, flag ditemukan di dalam dokumen tersebut."]}],"\n","$L26","\n","$L27"]
