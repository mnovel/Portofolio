10:["$","h2",null,{"children":"1. Preparation (Persiapan)"}]
11:["$","p",null,{"children":"Tahap paling menentukan sebelum insiden terjadi. Fokus utama pada fase ini adalah membangun kesiapan infrastruktur dan tim:"}]
12:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Menyusun ",["$","em",null,{"children":"Incident Response Plan (IRP)"}]," beserta matriks eskalasi kontak darurat."]}],"\n",["$","li",null,{"children":["Mengaktifkan ",["$","em",null,{"children":"centralized logging"}]," (SIEM) dengan sinkronisasi waktu NTP yang akurat di seluruh server."]}],"\n",["$","li",null,{"children":["Menyiapkan ",["$","em",null,{"children":"Jump Bag"}]," forensik (perangkat lunak akuisisi memori, ",["$","em",null,{"children":"live response scripts"}],", dan media penyimpanan steril)."]}],"\n"]}]
13:["$","h2",null,{"children":"2. Identification (Identifikasi & Triase)"}]
14:["$","p",null,{"children":["Membedakan antara anomali operasional biasa (",["$","em",null,{"children":"false positive"}],") dan insiden keamanan nyata (",["$","em",null,{"children":"true positive"}],") melalui analisis peringatan SIEM, IDS/IPS, maupun laporan pengguna."]}]
15:["$","p",null,{"children":["Pada tahap ini, ",["$","strong",null,{"children":"Incident Handler"}]," mendokumentasikan waktu deteksi awal (",["$","em",null,{"children":"Time to Detect"}],"), menentukan ruang lingkup sistem terdampak, dan mengklasifikasikan tingkat keparahan insiden."]}]
16:["$","h2",null,{"children":"3. Containment (Isolasi Ancaman)"}]
17:["$","p",null,{"children":["Menghentikan penyebaran serangan (",["$","em",null,{"children":"lateral movement"}],") ke segmen jaringan lain tanpa langsung mematikan daya server (",["$","em",null,{"children":"hard shutdown"}],") yang dapat menghapus artefak penting di memori RAM:"]}]
18:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Short-term Containment"}],": Memutus koneksi jaringan pada host terinfeksi (isolasi VLAN atau mencabut kabel jaringan) sambil membiarkan sistem tetap menyala."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Forensic Acquisition"}],": Mengambil ",["$","em",null,{"children":"volatile memory dump"}]," (RAM), daftar proses aktif, koneksi jaringan, serta ",["$","em",null,{"children":"disk image"}]," sebelum melakukan perubahan apa pun pada sistem."]}],"\n"]}]
19:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"# Contoh pengumpulan informasi volatil awal pada Linux sebelum isolasi penuh\r\nss -tulpn > /mnt/forensic_usb/network_connections.txt\r\nps auxf > /mnt/forensic_usb/running_processes.txt\r\nlast -aiF > /mnt/forensic_usb/login_history.txt\n"}]}]
1a:["$","h2",null,{"children":"4. Eradication (Pemberantasan)"}]
1b:["$","p",null,{"children":"Menghapus akar penyebab insiden secara menyeluruh dari lingkungan sistem:"}]
1c:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Menghapus ",["$","em",null,{"children":"malware"}],", ",["$","em",null,{"children":"web shell"}],", ",["$","em",null,{"children":"scheduled tasks"}]," (cronjob) berbahaya, dan akun ",["$","em",null,{"children":"backdoor"}]," yang dibuat penyerang."]}],"\n",["$","li",null,{"children":["Menambal celah kerentanan aplikasi atau sistem operasi yang menjadi titik masuk awal (",["$","em",null,{"children":"initial access vector"}],")."]}],"\n"]}]
1d:["$","h2",null,{"children":"5. Recovery (Pemulihan Layanan)"}]
1e:["$","p",null,{"children":"Mengembalikan sistem ke lingkungan produksi secara bertahap dan terverifikasi:"}]
1f:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Melakukan pemulihan data dari ",["$","em",null,{"children":"clean backup"}]," yang telah dipastikan bebas dari ",["$","em",null,{"children":"malware"}],"."]}],"\n",["$","li",null,{"children":"Mereset seluruh kredensial, token API, dan kunci SSH yang berpotensi terkompromi."}],"\n",["$","li",null,{"children":["Melakukan pemantauan ketat (",["$","em",null,{"children":"enhanced monitoring"}],") pada log SIEM selama 24–72 jam pasca-pemulihan untuk memastikan tidak ada aktivitas lanjutan."]}],"\n"]}]
20:["$","h2",null,{"children":"6. Lessons Learned (Evaluasi Pasca-Insiden)"}]
21:["$","p",null,{"children":["Menyelenggarakan pertemuan evaluasi (",["$","em",null,{"children":"post-mortem"}],") dan menyusun laporan kronologi lengkap (",["$","em",null,{"children":"Root Cause Analysis"}],") dalam 1–2 minggu setelah insiden selesai. Hasil temuan digunakan untuk memperbarui ",["$","em",null,{"children":"rules"}]," deteksi SIEM/IDS serta memperketat kebijakan keamanan organisasi."]}]
