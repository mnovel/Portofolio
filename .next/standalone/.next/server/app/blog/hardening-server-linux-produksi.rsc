23:[["$","p",null,{"children":["Mengamankan server Linux sebelum terhubung ke jaringan produksi adalah langkah fundamental dalam ",["$","strong",null,{"children":"Infrastructure Security"}],". Konfigurasi bawaan (",["$","em",null,{"children":"default"}],") sistem operasi umumnya dirancang untuk kemudahan akses dan kompatibilitas, bukan keamanan maksimal."]}],"\n",["$","p",null,{"children":["Artikel ini merangkum standar ",["$","em",null,{"children":"hardening"}]," server berbasis Ubuntu/Debian yang dapat langsung diterapkan pada lingkungan produksi."]}],"\n",["$","h2",null,{"children":"1. Perbarui Sistem dan Aktifkan Security Patch Otomatis"}],"\n",["$","p",null,{"children":"Kerentanan pada paket sistem operasi yang usang merupakan celah paling sering dieksploitasi. Pastikan seluruh paket diperbarui dan aktifkan pembaruan keamanan otomatis:"}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo apt update && sudo apt upgrade -y\r\nsudo apt install unattended-upgrades apt-listchanges -y\r\nsudo dpkg-reconfigure --priority=low unattended-upgrades\n"}]}],"\n",["$","h2",null,{"children":"2. Amankan Layanan SSH (Secure Shell)"}],"\n",["$","p",null,{"children":["Port 22 merupakan target utama pemindaian otomatis dan serangan ",["$","em",null,{"children":"brute-force"}]," di internet. Buat backup konfigurasi awal terlebih dahulu, lalu perketat aturan di ",["$","code",null,{"children":"/etc/ssh/sshd_config"}],":"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak\n"}]}],"\n",["$","p",null,{"children":["Ubah parameter berikut di dalam ",["$","code",null,{"children":"/etc/ssh/sshd_config"}],":"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-text","children":"PermitRootLogin no\r\nPasswordAuthentication no\r\nPubkeyAuthentication yes\r\nPermitEmptyPasswords no\r\nMaxAuthTries 3\r\nClientAliveInterval 300\r\nClientAliveCountMax 2\r\nAllowUsers admin_deploy\n"}]}],"\n",["$","p",null,{"children":"Validasi sintaks konfigurasi sebelum me-restart layanan SSH agar sesi Anda tidak terkunci:"}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo sshd -t && sudo systemctl restart ssh\n"}]}],"\n",["$","h2",null,{"children":"3. Terapkan Kebijakan Firewall Default-Deny dengan UFW"}],"\n",["$","p",null,{"children":["Terapkan prinsip ",["$","em",null,{"children":"least privilege"}]," pada level jaringan dengan memblokir seluruh koneksi masuk (",["$","em",null,{"children":"incoming"}],") secara default, dan hanya membuka port layanan yang benar-benar diperlukan:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo ufw default deny incoming\r\nsudo ufw default allow outgoing\r\nsudo ufw allow 22/tcp comment 'SSH Access'\r\nsudo ufw allow 443/tcp comment 'HTTPS Traffic'\r\nsudo ufw enable\r\nsudo ufw status verbose\n"}]}],"\n",["$","h2",null,{"children":"4. Proteksi Brute-Force Otomatis dengan Fail2Ban"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Fail2Ban"}]," memantau log autentikasi (",["$","code",null,{"children":"/var/log/auth.log"}],") secara real-time dan memblokir alamat IP yang melakukan percobaan login gagal berulang kali menggunakan aturan firewall:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo apt install fail2ban -y\r\nsudo cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local\n"}]}],"\n",["$","p",null,{"children":["Aktifkan proteksi ",["$","code",null,{"children":"sshd"}]," di ",["$","code",null,{"children":"/etc/fail2ban/jail.local"}],":"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-ini","children":"[sshd]\r\nenabled = true\r\nport = ssh\r\nfilter = sshd\r\nlogpath = /var/log/auth.log\r\nmaxretry = 3\r\nbantime = 3600\r\nfindtime = 600\n"}]}],"\n",["$","p",null,{"children":"Jalankan layanan Fail2Ban:"}],"\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b","\n","$L2c","\n","$L2d"]
24:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo systemctl enable --now fail2ban\r\nsudo fail2ban-client status sshd\n"}]}]
25:["$","h2",null,{"children":"5. Perkuat Parameter Jaringan Kernel (sysctl)"}]
26:["$","p",null,{"children":["Tambahkan konfigurasi keamanan kernel di ",["$","code",null,{"children":"/etc/sysctl.d/99-security-hardening.conf"}]," untuk memitigasi serangan ",["$","em",null,{"children":"IP spoofing"}],", ",["$","em",null,{"children":"ICMP redirect"}],", dan ",["$","em",null,{"children":"SYN flood"}],":"]}]
27:["$","pre",null,{"children":["$","code",null,{"className":"language-ini","children":"# Proteksi SYN Flood\r\nnet.ipv4.tcp_syncookies = 1\r\n\r\n# Cegah IP Spoofing (Reverse Path Filtering)\r\nnet.ipv4.conf.all.rp_filter = 1\r\nnet.ipv4.conf.default.rp_filter = 1\r\n\r\n# Tolak ICMP Redirects (Mencegah MITM Routing)\r\nnet.ipv4.conf.all.accept_redirects = 0\r\nnet.ipv4.conf.default.accept_redirects = 0\r\nnet.ipv4.conf.all.send_redirects = 0\r\n\r\n# Abaikan Broadcast Ping (Mencegah Smurf Attack)\r\nnet.ipv4.icmp_echo_ignore_broadcasts = 1\n"}]}]
28:["$","p",null,{"children":["Terapkan pengaturan tanpa perlu ",["$","em",null,{"children":"reboot"}]," server:"]}]
29:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo sysctl --system\n"}]}]
2a:["$","h2",null,{"children":"6. Nonaktifkan Layanan & Port yang Tidak Digunakan"}]
2b:["$","p",null,{"children":["Periksa seluruh layanan yang sedang mendengarkan koneksi jaringan (",["$","em",null,{"children":"listening ports"}],") dan matikan daemon yang tidak relevan dengan fungsi server:"]}]
2c:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo ss -tulpn\n"}]}]
