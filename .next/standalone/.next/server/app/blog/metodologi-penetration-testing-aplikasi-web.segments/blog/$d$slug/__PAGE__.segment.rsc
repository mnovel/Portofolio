18:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Broken Access Control (IDOR & Privilege Escalation)"}],": Menguji apakah pengguna dengan hak akses rendah dapat membaca atau memodifikasi data milik pengguna lain dengan memanipulasi ID objek atau ",["$","em",null,{"children":"role parameter"}]," pada request API."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Injection (SQLi, Command Injection, SSTI)"}],": Menguji sanitasi dan validasi input pada kueri database maupun pemrosesan template di sisi server."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Authentication & Session Management"}],": Menguji kelemahan validasi ",["$","em",null,{"children":"JSON Web Token (JWT)"}]," (seperti ",["$","em",null,{"children":"algorithm confusion"}]," atau ",["$","em",null,{"children":"weak secret"}],"), celah ",["$","em",null,{"children":"password reset"}],", serta ketiadaan ",["$","em",null,{"children":"rate limiting"}]," pada endpoint autentikasi."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Server-Side Request Forgery (SSRF)"}],": Menguji apakah parameter URL atau ",["$","em",null,{"children":"webhook"}]," dapat dimanfaatkan untuk mengakses layanan internal atau ",["$","em",null,{"children":"cloud metadata endpoint"}],"."]}],"\n"]}]
