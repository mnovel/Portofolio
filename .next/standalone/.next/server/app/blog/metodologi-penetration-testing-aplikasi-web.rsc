24:[["$","p",null,{"children":[["$","strong",null,{"children":"Penetration Testing"}]," aplikasi web bukan sekadar menjalankan pemindai kerentanan otomatis, melainkan simulasi serangan terkendali untuk menguji ketahanan logika bisnis, mekanisme autentikasi, dan kontrol akses aplikasi."]}],"\n",["$","p",null,{"children":["Mengacu pada ",["$","strong",null,{"children":"OWASP Web Security Testing Guide (WSTG)"}],", berikut tahapan sistematis dalam melakukan pengujian penetrasi aplikasi web modern."]}],"\n",["$","h2",null,{"children":"1. Reconnaissance & Information Gathering"}],"\n",["$","p",null,{"children":"Tahap awal bertujuan mengumpulkan informasi pasif maupun aktif mengenai arsitektur target sebelum menyentuh aplikasi secara langsung:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Enumerasi subdomain, sertifikat SSL/TLS (",["$","em",null,{"children":"Certificate Transparency logs"}],"), dan aset yang terekspos ke publik."]}],"\n",["$","li",null,{"children":["Identifikasi ",["$","em",null,{"children":"tech stack"}]," aplikasi (web server, reverse proxy, framework backend, WAF, dan dokumentasi API publik seperti Swagger/OpenAPI)."]}],"\n"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"# Contoh enumerasi subdomain pasif dan pengecekan status HTTP\r\nsubfinder -d targetdomain.com -silent | httpx -status-code -title -tech-detect\n"}]}],"\n",["$","h2",null,{"children":"2. Mapping Attack Surface"}],"\n",["$","p",null,{"children":["Setelah lingkup target dipetakan, langkah berikutnya adalah memahami alur kerja aplikasi secara menyeluruh menggunakan ",["$","em",null,{"children":"intercepting proxy"}]," seperti ",["$","strong",null,{"children":"Burp Suite"}],":"]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Menelusuri seluruh fitur aplikasi menggunakan berbagai peran pengguna (",["$","em",null,{"children":"Admin"}],", ",["$","em",null,{"children":"Staff"}],", ",["$","em",null,{"children":"Regular User"}],", dan ",["$","em",null,{"children":"Unauthenticated"}],")."]}],"\n",["$","li",null,{"children":["Memetakan seluruh ",["$","em",null,{"children":"endpoint"}]," REST API / GraphQL, parameter input (",["$","code",null,{"children":"GET"}],", ",["$","code",null,{"children":"POST"}],", ",["$","code",null,{"children":"JSON"}],", ",["$","code",null,{"children":"Header"}],"), serta mekanisme manajemen sesi (",["$","em",null,{"children":"Cookies"}]," dan ",["$","em",null,{"children":"JWT"}],")."]}],"\n"]}],"\n",["$","h2",null,{"children":"3. Pengujian Kerentanan Kritis (OWASP Top 10)"}],"\n",["$","p",null,{"children":"Fokus pengujian diarahkan pada celah yang memiliki dampak bisnis tinggi terhadap kerahasiaan, integritas, dan ketersediaan data:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Broken Access Control (IDOR & Privilege Escalation)"}],": Menguji apakah pengguna dengan hak akses rendah dapat membaca atau memodifikasi data milik pengguna lain dengan memanipulasi ID objek atau ",["$","em",null,{"children":"role parameter"}]," pada request API."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Injection (SQLi, Command Injection, SSTI)"}],": Menguji sanitasi dan validasi input pada kueri database maupun pemrosesan template di sisi server."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Authentication & Session Management"}],": Menguji kelemahan validasi ",["$","em",null,{"children":"JSON Web Token (JWT)"}]," (seperti ",["$","em",null,{"children":"algorithm confusion"}]," atau ",["$","em",null,{"children":"weak secret"}],"), celah ",["$","em",null,{"children":"password reset"}],", serta ketiadaan ",["$","em",null,{"children":"rate limiting"}]," pada endpoint autentikasi."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Server-Side Request Forgery (SSRF)"}],": Menguji apakah parameter URL atau ",["$","em",null,{"children":"webhook"}]," dapat dimanfaatkan untuk mengakses layanan internal atau ",["$","em",null,{"children":"cloud metadata endpoint"}],"."]}],"\n"]}],"\n",["$","h2",null,{"children":"4. Eksploitasi Terkendali & Proof of Concept (PoC)"}],"\n","$L25","\n","$L26","\n","$L27","\n","$L28"]
