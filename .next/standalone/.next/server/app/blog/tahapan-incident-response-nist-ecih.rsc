23:[["$","p",null,{"children":["Ketika serangan ",["$","em",null,{"children":"ransomware"}]," atau kebocoran data terjadi, kepanikan dan tindakan reaktif tanpa prosedur dapat merusak barang bukti digital serta memperluas dampak serangan ke seluruh jaringan. Kerangka kerja ",["$","strong",null,{"children":"Incident Handling & Response (IH&R)"}]," memastikan tim keamanan bertindak cepat, terukur, dan ",["$","em",null,{"children":"forensic-ready"}],"."]}],"\n",["$","h2",null,{"children":"1. Preparation (Persiapan)"}],"\n",["$","p",null,{"children":"Tahap paling menentukan sebelum insiden terjadi. Fokus utama pada fase ini adalah membangun kesiapan infrastruktur dan tim:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Menyusun ",["$","em",null,{"children":"Incident Response Plan (IRP)"}]," beserta matriks eskalasi kontak darurat."]}],"\n",["$","li",null,{"children":["Mengaktifkan ",["$","em",null,{"children":"centralized logging"}]," (SIEM) dengan sinkronisasi waktu NTP yang akurat di seluruh server."]}],"\n",["$","li",null,{"children":["Menyiapkan ",["$","em",null,{"children":"Jump Bag"}]," forensik (perangkat lunak akuisisi memori, ",["$","em",null,{"children":"live response scripts"}],", dan media penyimpanan steril)."]}],"\n"]}],"\n",["$","h2",null,{"children":"2. Identification (Identifikasi & Triase)"}],"\n",["$","p",null,{"children":["Membedakan antara anomali operasional biasa (",["$","em",null,{"children":"false positive"}],") dan insiden keamanan nyata (",["$","em",null,{"children":"true positive"}],") melalui analisis peringatan SIEM, IDS/IPS, maupun laporan pengguna."]}],"\n",["$","p",null,{"children":["Pada tahap ini, ",["$","strong",null,{"children":"Incident Handler"}]," mendokumentasikan waktu deteksi awal (",["$","em",null,{"children":"Time to Detect"}],"), menentukan ruang lingkup sistem terdampak, dan mengklasifikasikan tingkat keparahan insiden."]}],"\n",["$","h2",null,{"children":"3. Containment (Isolasi Ancaman)"}],"\n",["$","p",null,{"children":["Menghentikan penyebaran serangan (",["$","em",null,{"children":"lateral movement"}],") ke segmen jaringan lain tanpa langsung mematikan daya server (",["$","em",null,{"children":"hard shutdown"}],") yang dapat menghapus artefak penting di memori RAM:"]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Short-term Containment"}],": Memutus koneksi jaringan pada host terinfeksi (isolasi VLAN atau mencabut kabel jaringan) sambil membiarkan sistem tetap menyala."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Forensic Acquisition"}],": Mengambil ",["$","em",null,{"children":"volatile memory dump"}]," (RAM), daftar proses aktif, koneksi jaringan, serta ",["$","em",null,{"children":"disk image"}]," sebelum melakukan perubahan apa pun pada sistem."]}],"\n"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"# Contoh pengumpulan informasi volatil awal pada Linux sebelum isolasi penuh\r\nss -tulpn > /mnt/forensic_usb/network_connections.txt\r\nps auxf > /mnt/forensic_usb/running_processes.txt\r\nlast -aiF > /mnt/forensic_usb/login_history.txt\n"}]}],"\n",["$","h2",null,{"children":"4. Eradication (Pemberantasan)"}],"\n",["$","p",null,{"children":"Menghapus akar penyebab insiden secara menyeluruh dari lingkungan sistem:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Menghapus ",["$","em",null,{"children":"malware"}],", ",["$","em",null,{"children":"web shell"}],", ",["$","em",null,{"children":"scheduled tasks"}]," (cronjob) berbahaya, dan akun ",["$","em",null,{"children":"backdoor"}]," yang dibuat penyerang."]}],"\n",["$","li",null,{"children":["Menambal celah kerentanan aplikasi atau sistem operasi yang menjadi titik masuk awal (",["$","em",null,{"children":"initial access vector"}],")."]}],"\n"]}],"\n",["$","h2",null,{"children":"5. Recovery (Pemulihan Layanan)"}],"\n",["$","p",null,{"children":"Mengembalikan sistem ke lingkungan produksi secara bertahap dan terverifikasi:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":["Melakukan pemulihan data dari ","$L24"," yang telah dipastikan bebas dari ","$L25","."]}],"\n","$L26","\n","$L27","\n"]}],"\n","$L28","\n","$L29"]
