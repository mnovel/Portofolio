12:["$","pre",null,{"children":["$","code",null,{"className":"language-text","children":"PermitRootLogin no\r\nPasswordAuthentication no\r\nPubkeyAuthentication yes\r\nPermitEmptyPasswords no\r\nMaxAuthTries 3\r\nClientAliveInterval 300\r\nClientAliveCountMax 2\r\nAllowUsers admin_deploy\n"}]}]
