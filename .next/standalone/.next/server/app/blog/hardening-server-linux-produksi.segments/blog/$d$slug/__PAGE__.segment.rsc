17:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo ufw default deny incoming\r\nsudo ufw default allow outgoing\r\nsudo ufw allow 22/tcp comment 'SSH Access'\r\nsudo ufw allow 443/tcp comment 'HTTPS Traffic'\r\nsudo ufw enable\r\nsudo ufw status verbose\n"}]}]
18:["$","h2",null,{"children":"4. Proteksi Brute-Force Otomatis dengan Fail2Ban"}]
