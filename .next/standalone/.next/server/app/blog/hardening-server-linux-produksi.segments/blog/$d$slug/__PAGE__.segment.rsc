1c:["$","pre",null,{"children":["$","code",null,{"className":"language-ini","children":"[sshd]\r\nenabled = true\r\nport = ssh\r\nfilter = sshd\r\nlogpath = /var/log/auth.log\r\nmaxretry = 3\r\nbantime = 3600\r\nfindtime = 600\n"}]}]
