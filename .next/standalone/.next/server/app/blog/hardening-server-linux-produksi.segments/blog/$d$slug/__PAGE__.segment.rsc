20:["$","p",null,{"children":["Tambahkan konfigurasi keamanan kernel di ",["$","code",null,{"children":"/etc/sysctl.d/99-security-hardening.conf"}]," untuk memitigasi serangan ",["$","em",null,{"children":"IP spoofing"}],", ",["$","em",null,{"children":"ICMP redirect"}],", dan ",["$","em",null,{"children":"SYN flood"}],":"]}]
21:["$","pre",null,{"children":["$","code",null,{"className":"language-ini","children":"# Proteksi SYN Flood\r\nnet.ipv4.tcp_syncookies = 1\r\n\r\n# Cegah IP Spoofing (Reverse Path Filtering)\r\nnet.ipv4.conf.all.rp_filter = 1\r\nnet.ipv4.conf.default.rp_filter = 1\r\n\r\n# Tolak ICMP Redirects (Mencegah MITM Routing)\r\nnet.ipv4.conf.all.accept_redirects = 0\r\nnet.ipv4.conf.default.accept_redirects = 0\r\nnet.ipv4.conf.all.send_redirects = 0\r\n\r\n# Abaikan Broadcast Ping (Mencegah Smurf Attack)\r\nnet.ipv4.icmp_echo_ignore_broadcasts = 1\n"}]}]
