f:["$","em",null,{"children":"hardening"}]
10:["$","h2",null,{"children":"1. Perbarui Sistem dan Aktifkan Security Patch Otomatis"}]
11:["$","p",null,{"children":"Kerentanan pada paket sistem operasi yang usang merupakan celah paling sering dieksploitasi. Pastikan seluruh paket diperbarui dan aktifkan pembaruan keamanan otomatis:"}]
12:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo apt update && sudo apt upgrade -y\r\nsudo apt install unattended-upgrades apt-listchanges -y\r\nsudo dpkg-reconfigure --priority=low unattended-upgrades\n"}]}]
13:["$","h2",null,{"children":"2. Amankan Layanan SSH (Secure Shell)"}]
14:["$","p",null,{"children":["Port 22 merupakan target utama pemindaian otomatis dan serangan ",["$","em",null,{"children":"brute-force"}]," di internet. Buat backup konfigurasi awal terlebih dahulu, lalu perketat aturan di ",["$","code",null,{"children":"/etc/ssh/sshd_config"}],":"]}]
15:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo cp /etc/ssh/sshd_config /etc/ssh/sshd_config.bak\n"}]}]
16:["$","p",null,{"children":["Ubah parameter berikut di dalam ",["$","code",null,{"children":"/etc/ssh/sshd_config"}],":"]}]
17:["$","pre",null,{"children":["$","code",null,{"className":"language-text","children":"PermitRootLogin no\r\nPasswordAuthentication no\r\nPubkeyAuthentication yes\r\nPermitEmptyPasswords no\r\nMaxAuthTries 3\r\nClientAliveInterval 300\r\nClientAliveCountMax 2\r\nAllowUsers admin_deploy\n"}]}]
18:["$","p",null,{"children":"Validasi sintaks konfigurasi sebelum me-restart layanan SSH agar sesi Anda tidak terkunci:"}]
19:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo sshd -t && sudo systemctl restart ssh\n"}]}]
1a:["$","h2",null,{"children":"3. Terapkan Kebijakan Firewall Default-Deny dengan UFW"}]
1b:["$","p",null,{"children":["Terapkan prinsip ",["$","em",null,{"children":"least privilege"}]," pada level jaringan dengan memblokir seluruh koneksi masuk (",["$","em",null,{"children":"incoming"}],") secara default, dan hanya membuka port layanan yang benar-benar diperlukan:"]}]
1c:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo ufw default deny incoming\r\nsudo ufw default allow outgoing\r\nsudo ufw allow 22/tcp comment 'SSH Access'\r\nsudo ufw allow 443/tcp comment 'HTTPS Traffic'\r\nsudo ufw enable\r\nsudo ufw status verbose\n"}]}]
1d:["$","h2",null,{"children":"4. Proteksi Brute-Force Otomatis dengan Fail2Ban"}]
1e:["$","p",null,{"children":[["$","strong",null,{"children":"Fail2Ban"}]," memantau log autentikasi (",["$","code",null,{"children":"/var/log/auth.log"}],") secara real-time dan memblokir alamat IP yang melakukan percobaan login gagal berulang kali menggunakan aturan firewall:"]}]
1f:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo apt install fail2ban -y\r\nsudo cp /etc/fail2ban/jail.conf /etc/fail2ban/jail.local\n"}]}]
20:["$","p",null,{"children":["Aktifkan proteksi ",["$","code",null,{"children":"sshd"}]," di ",["$","code",null,{"children":"/etc/fail2ban/jail.local"}],":"]}]
21:["$","pre",null,{"children":["$","code",null,{"className":"language-ini","children":"[sshd]\r\nenabled = true\r\nport = ssh\r\nfilter = sshd\r\nlogpath = /var/log/auth.log\r\nmaxretry = 3\r\nbantime = 3600\r\nfindtime = 600\n"}]}]
22:["$","p",null,{"children":"Jalankan layanan Fail2Ban:"}]
23:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo systemctl enable --now fail2ban\r\nsudo fail2ban-client status sshd\n"}]}]
24:["$","h2",null,{"children":"5. Perkuat Parameter Jaringan Kernel (sysctl)"}]
25:["$","p",null,{"children":["Tambahkan konfigurasi keamanan kernel di ",["$","code",null,{"children":"/etc/sysctl.d/99-security-hardening.conf"}]," untuk memitigasi serangan ",["$","em",null,{"children":"IP spoofing"}],", ",["$","em",null,{"children":"ICMP redirect"}],", dan ",["$","em",null,{"children":"SYN flood"}],":"]}]
26:["$","pre",null,{"children":["$","code",null,{"className":"language-ini","children":"# Proteksi SYN Flood\r\nnet.ipv4.tcp_syncookies = 1\r\n\r\n# Cegah IP Spoofing (Reverse Path Filtering)\r\nnet.ipv4.conf.all.rp_filter = 1\r\nnet.ipv4.conf.default.rp_filter = 1\r\n\r\n# Tolak ICMP Redirects (Mencegah MITM Routing)\r\nnet.ipv4.conf.all.accept_redirects = 0\r\nnet.ipv4.conf.default.accept_redirects = 0\r\nnet.ipv4.conf.all.send_redirects = 0\r\n\r\n# Abaikan Broadcast Ping (Mencegah Smurf Attack)\r\nnet.ipv4.icmp_echo_ignore_broadcasts = 1\n"}]}]
27:["$","p",null,{"children":["Terapkan pengaturan tanpa perlu ",["$","em",null,{"children":"reboot"}]," server:"]}]
28:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo sysctl --system\n"}]}]
29:["$","h2",null,{"children":"6. Nonaktifkan Layanan & Port yang Tidak Digunakan"}]
2a:["$","p",null,{"children":["Periksa seluruh layanan yang sedang mendengarkan koneksi jaringan (",["$","em",null,{"children":"listening ports"}],") dan matikan daemon yang tidak relevan dengan fungsi server:"]}]
2b:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo ss -tulpn\n"}]}]
2c:["$","p",null,{"children":["Dengan menerapkan enam lapisan dasar di atas, permukaan serangan (",["$","em",null,{"children":"attack surface"}],") server Linux produksi Anda akan berkurang secara signifikan sebelum memasuki tahap pemantauan SIEM/IDS."]}]
