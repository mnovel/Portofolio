24:[["$","p",null,{"children":["Dalam operasional ",["$","strong",null,{"children":"Security Operations Center (SOC)"}]," modern, visibilitas di level ",["$","em",null,{"children":"host"}]," saja tidak cukup. Menggabungkan ",["$","strong",null,{"children":"Wazuh"}]," sebagai ",["$","em",null,{"children":"Host-based Intrusion Detection System (HIDS) / SIEM"}]," dengan ",["$","strong",null,{"children":"Suricata"}]," sebagai ",["$","em",null,{"children":"Network IDS/IPS"}]," memberikan korelasi telemetri jaringan dan sistem secara menyeluruh."]}],"\n",["$","h2",null,{"children":"Mengapa Menggabungkan Wazuh dan Suricata?"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Suricata"}]," menganalisis paket jaringan melalui ",["$","em",null,{"children":"Deep Packet Inspection (DPI)"}]," untuk mendeteksi eksploitasi protokol, ",["$","em",null,{"children":"port scanning"}],", dan komunikasi ",["$","em",null,{"children":"Command and Control (C2)"}],"."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Wazuh"}]," mengumpulkan log sistem, memantau integritas file (",["$","em",null,{"children":"File Integrity Monitoring"}],"), dan menjalankan ",["$","em",null,{"children":"Active Response"}]," untuk memblokir IP penyerang secara otomatis."]}],"\n"]}],"\n",["$","h2",null,{"children":"Langkah 1: Konfigurasi Output EVE JSON pada Suricata"}],"\n",["$","p",null,{"children":["Pastikan Suricata mencatat seluruh peringatan (",["$","em",null,{"children":"alerts"}],") dalam format terstruktur ",["$","code",null,{"children":"eve.json"}]," di ",["$","code",null,{"children":"/etc/suricata/suricata.yaml"}],":"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-yaml","children":"outputs:\r\n  - eve-log:\r\n      enabled: yes\r\n      filetype: regular\r\n      filename: eve.json\r\n      types:\r\n        - alert:\r\n            tagged-packets: yes\r\n        - dns:\r\n            query: yes\r\n            answer: yes\r\n        - http:\r\n            extended: yes\n"}]}],"\n",["$","p",null,{"children":["Perbarui ",["$","em",null,{"children":"ruleset"}]," Emerging Threats, uji validitas konfigurasi, lalu jalankan ulang layanan Suricata:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo suricata-update\r\nsudo suricata -T -c /etc/suricata/suricata.yaml -v\r\nsudo systemctl restart suricata\n"}]}],"\n",["$","h2",null,{"children":"Langkah 2: Membaca Log Suricata dari Wazuh Agent"}],"\n",["$","p",null,{"children":["Tambahkan blok ",["$","code",null,{"children":"localfile"}]," pada konfigurasi Wazuh Agent (",["$","code",null,{"children":"/var/ossec/etc/ossec.conf"}],") pada server yang dipantau agar log ",["$","code",null,{"children":"eve.json"}]," diteruskan ke Wazuh Manager:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-xml","children":"<localfile>\r\n  <log_format>json</log_format>\r\n  <location>/var/log/suricata/eve.json</location>\r\n</localfile>\n"}]}],"\n",["$","p",null,{"children":"Restart layanan agen agar aturan baru berjalan:"}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo systemctl restart wazuh-agent\n"}]}],"\n",["$","h2",null,{"children":"Langkah 3: Mengaktifkan Active Response untuk Blokir Otomatis"}],"\n",["$","p",null,{"children":["Pada ",["$","strong",null,{"children":"Wazuh Manager"}]," (",["$","code",null,{"children":"/var/ossec/etc/ossec.conf"}],"), Anda dapat mengonfigurasi ",["$","em",null,{"children":"Active Response"}]," untuk memblokir alamat IP sumber serangan secara otomatis ketika Suricata memicu ",["$","em",null,{"children":"alert"}]," dengan tingkat keparahan tinggi (Rule ID ",["$","code",null,{"children":"86601"}],"):"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-xml","children":"<active-response>\r\n  <command>firewall-drop</command>\r\n  <location>local</location>\r\n  <rules_id>86601</rules_id>\r\n  <timeout>1800</timeout>\r\n</active-response>\n"}]}],"\n",["$","p",null,{"children":"Restart Wazuh Manager untuk menerapkan kebijakan respons otomatis:"}],"\n",["$","pre",null,{"children":"$L25"}],"\n","$L26","\n","$L27"]
25:["$","code",null,{"className":"language-bash","children":"sudo systemctl restart wazuh-manager\n"}]
