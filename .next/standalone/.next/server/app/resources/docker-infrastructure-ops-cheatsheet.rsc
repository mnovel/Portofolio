24:[["$","p",null,{"children":["Kumpulan perintah harian untuk mengelola, mengaudit, dan memperkeras konfigurasi keamanan container ",["$","strong",null,{"children":"Docker"}]," di server produksi."]}],"\n",["$","h2",null,{"children":"1. Menjalankan Container dengan Prinsip Least Privilege"}],"\n",["$","p",null,{"children":["Menjalankan container dalam mode ",["$","em",null,{"children":"read-only"}],", mencabut seluruh ",["$","em",null,{"children":"Linux capabilities"}],", dan mencegah proses di dalam container mendapatkan hak istimewa baru:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"docker run -d \\\r\n  --name secure-service \\\r\n  --read-only \\\r\n  --tmpfs /tmp:rw,noexec,nosuid \\\r\n  --cap-drop=ALL \\\r\n  --security-opt=no-new-privileges:true \\\r\n  --memory=\"512m\" \\\r\n  --cpus=\"1.0\" \\\r\n  my-app:latest\n"}]}],"\n",["$","h2",null,{"children":"2. Monitoring & Audit Container Aktif"}],"\n",["$","p",null,{"children":"Menampilkan ringkasan status, eksposur port, dan konsumsi resource container secara real-time:"}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"docker ps --format \"table {{.Names}}\\t{{.Image}}\\t{{.Status}}\\t{{.Ports}}\"\r\ndocker stats --no-stream\n"}]}],"\n",["$","h2",null,{"children":"3. Inspeksi Jaringan, Volume & Konfigurasi Keamanan"}],"\n",["$","p",null,{"children":["Memeriksa apakah container berjalan sebagai ",["$","code",null,{"children":"root"}]," atau memiliki ",["$","em",null,{"children":"mount"}]," sensitif dari mesin ",["$","em",null,{"children":"host"}],":"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"docker inspect --format '{{.Name}} -> User: {{.Config.User}} | Privileged: {{.HostConfig.Privileged}}' $(docker ps -q)\r\ndocker network ls\n"}]}],"\n",["$","h2",null,{"children":"4. Pembersihan Artefak & Image Tidak Terpakai"}],"\n",["$","p",null,{"children":["Menjaga kapasitas disk server tetap optimal dengan menghapus ",["$","em",null,{"children":"dangling images"}]," dan ",["$","em",null,{"children":"build cache"}]," lama secara aman:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"docker system df\r\ndocker image prune -f\r\ndocker builder prune --filter \"until=168h\" -f\n"}]}]]
