23:[["$","p",null,{"children":["Referensi cepat untuk memverifikasi potensi jalur eskalasi hak akses (",["$","em",null,{"children":"privilege escalation"}],") saat melakukan ",["$","em",null,{"children":"penetration testing"}]," maupun audit internal server Linux."]}],"\n",["$","h2",null,{"children":"1. Informasi Sistem, Kernel & Lingkungan"}],"\n",["$","p",null,{"children":["Memeriksa versi kernel, distribusi OS, dan variabel ",["$","em",null,{"children":"environment"}]," yang berpotensi menyimpan kredensial:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"uname -a && cat /etc/os-release\r\nid && groups\r\nenv\n"}]}],"\n",["$","h2",null,{"children":"2. Audit Hak Akses Sudo & Password Storage"}],"\n",["$","p",null,{"children":["Memeriksa perintah apa saja yang dapat dijalankan pengguna saat ini dengan hak ",["$","code",null,{"children":"root"}]," tanpa atau dengan password:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"sudo -l\r\nls -la /etc/passwd /etc/shadow\n"}]}],"\n",["$","h2",null,{"children":"3. Pencarian Binary SUID & SGID"}],"\n",["$","p",null,{"children":["Menemukan file eksekusi yang berjalan dengan hak akses pemilik file (",["$","code",null,{"children":"root"}],"):"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"find / -perm -4000 -type f 2>/dev/null\r\nfind / -perm -2000 -type f 2>/dev/null\n"}]}],"\n",["$","h2",null,{"children":"4. Audit Linux File Capabilities"}],"\n",["$","p",null,{"children":["Memeriksa biner yang memiliki kapabilitas khusus kernel (seperti ",["$","code",null,{"children":"cap_setuid"}],", ",["$","code",null,{"children":"cap_net_raw"}],", atau ",["$","code",null,{"children":"cap_dac_read_search"}],"):"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"getcap -r / 2>/dev/null\n"}]}],"\n",["$","h2",null,{"children":"5. Audit Writable Directories & Scheduled Tasks"}],"\n",["$","p",null,{"children":["Mendeteksi file skrip yang dijalankan oleh ",["$","code",null,{"children":"root"}]," secara berkala namun memiliki izin tulis (",["$","em",null,{"children":"world-writable"}],") bagi pengguna biasa:"]}],"\n",["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"cat /etc/crontab\r\nfind / -writable -type d 2>/dev/null | grep -vE \"^(/proc|/sys|/dev)\"\n"}]}]]
