11:["$","p",null,{"children":["Menjalankan container dalam mode ",["$","em",null,{"children":"read-only"}],", mencabut seluruh ",["$","em",null,{"children":"Linux capabilities"}],", dan mencegah proses di dalam container mendapatkan hak istimewa baru:"]}]
12:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"docker run -d \\\r\n  --name secure-service \\\r\n  --read-only \\\r\n  --tmpfs /tmp:rw,noexec,nosuid \\\r\n  --cap-drop=ALL \\\r\n  --security-opt=no-new-privileges:true \\\r\n  --memory=\"512m\" \\\r\n  --cpus=\"1.0\" \\\r\n  my-app:latest\n"}]}]
