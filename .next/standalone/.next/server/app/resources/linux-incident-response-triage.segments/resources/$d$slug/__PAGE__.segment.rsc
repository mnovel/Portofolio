15:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"ps auxf --sort=-%cpu | head -n 25\r\nls -la /proc/*/exe 2>/dev/null | grep deleted\n"}]}]
16:["$","h2",null,{"children":"3. Audit Persistence Mechanism (Cron, Systemd, SSH Keys)"}]
17:["$","p",null,{"children":"Memeriksa jadwal eksekusi otomatis dan kunci akses yang mungkin disisipkan penyerang:"}]
18:["$","pre",null,{"children":["$","code",null,{"className":"language-bash","children":"crontab -l\r\nls -la /etc/cron* /var/spool/cron/crontabs/\r\nsystemctl list-units --type=service --state=running\r\nfind /home /root -name \"authorized_keys\" -exec ls -la {} \\;\n"}]}]
